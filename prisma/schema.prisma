generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model actividad {
  id                       String                @id
  proyectoId               String
  descripcion              String                @db.Text
  tipo                     actividad_tipo
  prioridad                actividad_prioridad
  estado                   actividad_estado
  fechaCreacion            DateTime              @default(now())
  fechaInicio              DateTime?
  fechaFin                 DateTime?
  fechaVencimiento         DateTime?
  responsablePrincipalId   String
  responsablesApoyo        String                @db.LongText
  checklistBloqueado       Boolean?              @default(false)
  motivoBloqueoChecklist   String?
  desbloqueadoPor          String?
  fechaDesbloqueoChecklist DateTime?
  observaciones            String?               @db.Text
  seguimientoOperativo     String?               @db.Text
  progreso                 Float                 @default(0)
  ponderacion              Float?
  orden                    Int?
  padreId                  String?
  esSuboperacion           Boolean?              @default(false)
  proyecto                 proyecto              @relation(fields: [proyectoId], references: [id], map: "Actividad_proyectoId_fkey")
  responsable              responsable           @relation(fields: [responsablePrincipalId], references: [id], map: "Actividad_responsablePrincipalId_fkey")
  comentario               comentario[]
  evidencia                evidencia[]
  historialcambio          historialcambio[]
  subtarea                 subtarea[]
  validacionrequerida      validacionrequerida[]

  @@index([proyectoId], map: "Actividad_proyectoId_fkey")
  @@index([responsablePrincipalId], map: "Actividad_responsablePrincipalId_fkey")
}

model actividad_comercial {
  id                 String                            @id
  clienteId          String
  usuarioId          String
  tipoActividad      actividad_comercial_tipoActividad
  descripcion        String                            @db.Text
  fechaActividad     DateTime                          @default(now())
  proximoSeguimiento DateTime?
  estado             actividad_comercial_estado        @default(PENDIENTE)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime
  cliente            cliente                           @relation(fields: [clienteId], references: [id], onDelete: Cascade, map: "ACTIVIDAD_COMERCIAL_clienteId_fkey")
  notificacion       notificacion[]

  @@index([clienteId], map: "ACTIVIDAD_COMERCIAL_clienteId_fkey")
}

model adelanto_proyecto {
  id                    String                   @id
  proyectoId            String
  monto                 Decimal                  @db.Decimal(18, 2)
  fechaRecibido         DateTime                 @default(now())
  metodo                adelanto_proyecto_metodo @default(TRANSFERENCIA)
  referencia            String?
  comprobanteUrl        String?
  montoAplicado         Decimal                  @default(0.00) @db.Decimal(18, 2)
  saldoDisponible       Decimal                  @default(0.00) @db.Decimal(18, 2)
  observaciones         String?                  @db.Text
  registradoPorId       String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime
  proyecto              proyecto                 @relation(fields: [proyectoId], references: [id], onDelete: Cascade, map: "ADELANTO_PROYECTO_proyectoId_fkey")
  distribucion_adelanto distribucion_adelanto[]

  @@index([proyectoId], map: "ADELANTO_PROYECTO_proyectoId_fkey")
}

model aprobacion_gasto {
  id         String                  @id
  gastoId    String
  usuarioId  String
  nivel      Int
  rol        String
  estado     aprobacion_gasto_estado @default(APROBADO)
  comentario String?                 @db.Text
  fecha      DateTime                @default(now())
  gasto      gasto                   @relation(fields: [gastoId], references: [id], onDelete: Cascade, map: "APROBACION_GASTO_gastoId_fkey")
  usuario    usuario                 @relation(fields: [usuarioId], references: [id], map: "APROBACION_GASTO_usuarioId_fkey")

  @@index([gastoId], map: "APROBACION_GASTO_gastoId_idx")
  @@index([usuarioId], map: "APROBACION_GASTO_usuarioId_fkey")
}

model audit_log {
  id            String   @id
  usuarioId     String
  modulo        String
  accion        String
  detalles      String?  @db.LongText
  ip            String?
  fechaCreacion DateTime @default(now())
  usuario       usuario  @relation(fields: [usuarioId], references: [id], map: "AUDIT_LOG_usuarioId_fkey")

  @@index([usuarioId], map: "AUDIT_LOG_usuarioId_fkey")
}

model caja {
  id                  String             @id
  nombre              String             @unique(map: "CAJA_nombre_key")
  tipo                String             @default("BANCO")
  moneda              String             @default("PEN")
  saldoReal           Decimal            @default(0.00) @db.Decimal(18, 2)
  saldoComprometido   Decimal            @default(0.00) @db.Decimal(18, 2)
  saldoDisponible     Decimal            @default(0.00) @db.Decimal(18, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  esProtegida         Boolean            @default(false)
  esPrincipal         Boolean            @default(false)
  porcentajeProvision Decimal            @default(0.00) @db.Decimal(18, 2)
  subtipo             caja_subtipo       @default(OPERATIVA)
  gasto               gasto[]
  pago                pago[]
  transaccion_caja    transaccion_caja[]
}

model cliente {
  id                   String                @id
  codigo               String                @unique(map: "CLIENTE_codigo_key")
  empresa              String
  ruc                  String?               @unique(map: "CLIENTE_ruc_key")
  direccion            String
  tarifa               String
  contacto             String
  telefono             String?
  cargo                String?
  correo               String?
  linkedin             String?
  cartera              String?
  asignadoA            String
  responsableId        String?
  diaTrabajo           String?
  estado               String
  prioridad            String
  accion               String
  ultimoContacto       DateTime?
  proximoSeguimiento   DateTime?
  observaciones        String?               @db.Text
  zona                 String
  semaforo             String
  temperatura          String
  montoEstimado        Decimal               @default(0.00) @db.Decimal(18, 2)
  probabilidad         Float                 @default(0)
  ventaProyectada      Decimal               @default(0.00) @db.Decimal(18, 2)
  tipoCliente          cliente_tipoCliente   @default(PROSPECTO)
  clasificacion        cliente_clasificacion @default(RENTABLE)
  esClienteReal        Boolean               @default(false)
  etapaComercial       String
  hallazgosTecnicos    String?               @db.LongText
  solucionesPropuestas String?               @db.LongText
  propuestaTecnicaUrl  String?
  deletedAt            DateTime?
  fechaCreacion        DateTime              @default(now())
  fechaActualizacion   DateTime?
  actividad_comercial  actividad_comercial[]
  responsable          responsable?          @relation(fields: [responsableId], references: [id], map: "CLIENTE_responsableId_fkey")
  cotizacion           cotizacion[]
  documento            documento[]
  factura              factura[]
  ficha_tecnica        ficha_tecnica[]
  interaccion          interaccion[]
  proyecto             proyecto[]

  @@index([empresa], map: "CLIENTE_empresa_idx")
  @@index([responsableId], map: "CLIENTE_responsableId_fkey")
  @@index([ruc], map: "CLIENTE_ruc_idx")
  @@index([zona], map: "CLIENTE_zona_idx")
}

model comentario {
  id          String                 @id
  proyectoId  String?
  actividadId String?
  usuario     String
  usuarioArea comentario_usuarioArea
  contenido   String                 @db.Text
  fecha       DateTime               @default(now())
  esInterno   Boolean                @default(false)
  actividad   actividad?             @relation(fields: [actividadId], references: [id], onDelete: Cascade, map: "Comentario_actividadId_fkey")
  proyecto    proyecto?              @relation(fields: [proyectoId], references: [id], onDelete: Cascade, map: "Comentario_proyectoId_fkey")

  @@index([actividadId], map: "Comentario_actividadId_fkey")
  @@index([proyectoId], map: "Comentario_proyectoId_fkey")
}

model configuracion_aprobacion {
  id               String                             @id
  tipoGasto        configuracion_aprobacion_tipoGasto
  montoMinimo      Decimal                            @db.Decimal(18, 2)
  montoMaximo      Decimal                            @db.Decimal(18, 2)
  prioridad        configuracion_aprobacion_prioridad @default(MEDIA)
  rolesAprobadores String                             @db.LongText
  activo           Boolean                            @default(true)
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime
}

model cotizacion {
  id                 String        @id
  codigo             String        @unique(map: "COTIZACION_codigo_key")
  clientId           String
  referencia         String?       @db.Text
  objetivo           String?       @db.Text
  alcance            String?       @db.LongText
  consideraciones    String?       @db.Text
  entregables        String?       @db.Text
  monto              Decimal       @default(0.00) @db.Decimal(18, 2)
  estado             String
  fecha              DateTime      @default(now())
  plazo              String?       @default("7 días")
  validez            String?       @default("15 días")
  formaPago          String?       @db.Text
  observaciones      String?       @db.Text
  version            Int           @default(1)
  cotizacionPadreId  String?
  proyectoGeneradoId String?       @unique(map: "COTIZACION_proyectoGeneradoId_key")
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime?
  moneda             String        @default("PEN")
  cliente            cliente       @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "COTIZACION_clientId_fkey")
  cotizacion         cotizacion?   @relation("cotizacionTocotizacion", fields: [cotizacionPadreId], references: [id], map: "COTIZACION_cotizacionPadreId_fkey")
  other_cotizacion   cotizacion[]  @relation("cotizacionTocotizacion")
  proyecto           proyecto?     @relation(fields: [proyectoGeneradoId], references: [id], map: "COTIZACION_proyectoGeneradoId_fkey")
  documento          documento[]
  factura            factura[]
  hito_pago          hito_pago[]
  interaccion        interaccion[]

  @@index([clientId], map: "COTIZACION_clientId_fkey")
  @@index([cotizacionPadreId], map: "COTIZACION_cotizacionPadreId_fkey")
}

model detalle_orden_compra {
  id             String       @id
  ordenId        String
  insumoId       String
  cantidad       Decimal      @db.Decimal(18, 4)
  precioUnitario Decimal      @db.Decimal(18, 2)
  subtotal       Decimal      @db.Decimal(18, 2)
  insumo         insumo       @relation(fields: [insumoId], references: [id], map: "DETALLE_ORDEN_COMPRA_insumoId_fkey")
  orden_compra   orden_compra @relation(fields: [ordenId], references: [id], onDelete: Cascade, map: "DETALLE_ORDEN_COMPRA_ordenId_fkey")

  @@index([insumoId], map: "DETALLE_ORDEN_COMPRA_insumoId_fkey")
  @@index([ordenId], map: "DETALLE_ORDEN_COMPRA_ordenId_fkey")
}

model distribucion_adelanto {
  id                String                          @id
  adelantoId        String
  categoria         distribucion_adelanto_categoria
  montoAsignado     Decimal                         @db.Decimal(18, 2)
  montoGastado      Decimal                         @default(0.00) @db.Decimal(18, 2)
  saldoDisponible   Decimal                         @db.Decimal(18, 2)
  adelanto_proyecto adelanto_proyecto               @relation(fields: [adelantoId], references: [id], onDelete: Cascade, map: "DISTRIBUCION_ADELANTO_adelantoId_fkey")

  @@index([adelantoId], map: "DISTRIBUCION_ADELANTO_adelantoId_fkey")
}

model documento {
  id                  String             @id
  proyectoId          String?
  expedienteTecnicoId String?
  clientId            String?
  cotizacionId        String?
  nombre              String
  tipo                documento_tipo
  subtype             String?
  numero              String?
  url                 String
  version             String?
  estado              documento_estado
  subidoPor           String
  tamano              String?
  fechaSubida         DateTime           @default(now())
  fechaVencimiento    DateTime?
  observaciones       String?            @db.Text
  esEntregable        Boolean?           @default(false)
  cliente             cliente?           @relation(fields: [clientId], references: [id], map: "Documento_clientId_fkey")
  cotizacion          cotizacion?        @relation(fields: [cotizacionId], references: [id], map: "Documento_cotizacionId_fkey")
  expedientetecnico   expedientetecnico? @relation(fields: [expedienteTecnicoId], references: [id], map: "Documento_expedienteTecnicoId_fkey")
  proyecto            proyecto?          @relation(fields: [proyectoId], references: [id], map: "Documento_proyectoId_fkey")

  @@index([clientId], map: "Documento_clientId_fkey")
  @@index([cotizacionId], map: "Documento_cotizacionId_fkey")
  @@index([expedienteTecnicoId], map: "Documento_expedienteTecnicoId_fkey")
  @@index([proyectoId], map: "Documento_proyectoId_fkey")
}

model entregable {
  id              String       @id
  suboperacionId  String
  nombre          String
  descripcion     String?      @db.Text
  tipo            String
  url             String?
  estado          String
  fechaEntrega    DateTime?
  fechaAprobacion DateTime?
  aprobadoPor     String?
  suboperacion    suboperacion @relation(fields: [suboperacionId], references: [id], map: "Entregable_suboperacionId_fkey")

  @@index([suboperacionId], map: "Entregable_suboperacionId_fkey")
}

model evaluaciontecnica {
  id                   String   @id
  proyectoId           String   @unique(map: "EvaluacionTecnica_proyectoId_key")
  fechaEvaluacion      DateTime
  evaluadoPor          String
  hallazgos            String   @db.LongText
  solucionesPropuestas String   @db.LongText
  recomendaciones      String   @db.Text
  estado               String
  documentoUrl         String?
  proyecto             proyecto @relation(fields: [proyectoId], references: [id], map: "EvaluacionTecnica_proyectoId_fkey")
}

model evidencia {
  id              String         @id
  proyectoId      String?
  actividadId     String?
  reporteDiarioId String?
  nombre          String
  tipo            String
  url             String
  tamano          String
  subidoPor       String
  fecha           DateTime       @default(now())
  descripcion     String?        @db.Text
  actividad       actividad?     @relation(fields: [actividadId], references: [id], onDelete: Cascade, map: "Evidencia_actividadId_fkey")
  proyecto        proyecto?      @relation(fields: [proyectoId], references: [id], onDelete: Cascade, map: "Evidencia_proyectoId_fkey")
  reportediario   reportediario? @relation(fields: [reporteDiarioId], references: [id], onDelete: Cascade, map: "Evidencia_reporteDiarioId_fkey")

  @@index([actividadId], map: "Evidencia_actividadId_fkey")
  @@index([proyectoId], map: "Evidencia_proyectoId_fkey")
  @@index([reporteDiarioId], map: "Evidencia_reporteDiarioId_fkey")
}

model expedientetecnico {
  id                 String      @id
  proyectoId         String      @unique(map: "ExpedienteTecnico_proyectoId_key")
  numeroExpediente   String
  titulo             String
  descripcion        String?     @db.Text
  estado             String
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime
  documento          documento[]
  proyecto           proyecto    @relation(fields: [proyectoId], references: [id], map: "ExpedienteTecnico_proyectoId_fkey")
}

model factura {
  id                 String                @id
  codigo             String                @unique(map: "FACTURA_codigo_key")
  clienteId          String
  proyectoId         String?
  cotizacionId       String?
  clasificacion      factura_clasificacion @default(VENTA_SERVICIO)
  montoSubtotal      Decimal               @default(0.00) @db.Decimal(18, 2)
  montoIgv           Decimal               @default(0.00) @db.Decimal(18, 2)
  montoTotal         Decimal               @default(0.00) @db.Decimal(18, 2)
  saldoPendiente     Decimal               @default(0.00) @db.Decimal(18, 2)
  fechaEmision       DateTime              @default(now())
  fechaVencimiento   DateTime
  estado             factura_estado        @default(PENDIENTE)
  observaciones      String?               @db.Text
  archivoUrl         String?
  esRecurrente       Boolean               @default(false)
  frecuencia         String?
  proximaFacturacion DateTime?
  notificadoCobranza Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime
  fechaEstimadaCobro DateTime?
  hitoPagoId         String?
  cliente            cliente               @relation(fields: [clienteId], references: [id], map: "FACTURA_clienteId_fkey")
  cotizacion         cotizacion?           @relation(fields: [cotizacionId], references: [id], map: "FACTURA_cotizacionId_fkey")
  hito_pago          hito_pago?            @relation(fields: [hitoPagoId], references: [id], map: "FACTURA_hitoPagoId_fkey")
  proyecto           proyecto?             @relation(fields: [proyectoId], references: [id], map: "FACTURA_proyectoId_fkey")
  pago               pago[]

  @@index([clienteId], map: "FACTURA_clienteId_idx")
  @@index([cotizacionId], map: "FACTURA_cotizacionId_fkey")
  @@index([estado], map: "FACTURA_estado_idx")
  @@index([fechaEmision], map: "FACTURA_fechaEmision_idx")
  @@index([fechaEstimadaCobro], map: "FACTURA_fechaEstimadaCobro_idx")
  @@index([hitoPagoId], map: "FACTURA_hitoPagoId_fkey")
  @@index([proyectoId], map: "FACTURA_proyectoId_idx")
}

model ficha_tecnica {
  id                    String                  @id
  clienteId             String
  tecnicoId             String
  fechaVisita           DateTime
  observaciones         String?                 @db.Text
  hallazgos             String?                 @db.Text
  recomendaciones       String?                 @db.Text
  estado                String
  firmaTecnico          String?                 @db.Text
  datosTecnicos         String?                 @db.LongText
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  cliente               cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade, map: "FICHA_TECNICA_clienteId_fkey")
  responsable           responsable             @relation(fields: [tecnicoId], references: [id], map: "FICHA_TECNICA_tecnicoId_fkey")
  ficha_tecnica_adjunto ficha_tecnica_adjunto[]

  @@index([clienteId], map: "FICHA_TECNICA_clienteId_fkey")
  @@index([tecnicoId], map: "FICHA_TECNICA_tecnicoId_fkey")
}

model ficha_tecnica_adjunto {
  id             String        @id
  fichaTecnicaId String
  nombre         String
  url            String
  tipo           String
  createdAt      DateTime      @default(now())
  ficha_tecnica  ficha_tecnica @relation(fields: [fichaTecnicaId], references: [id], onDelete: Cascade, map: "FICHA_TECNICA_ADJUNTO_fichaTecnicaId_fkey")

  @@index([fichaTecnicaId], map: "FICHA_TECNICA_ADJUNTO_fichaTecnicaId_fkey")
}

model gasto {
  id                    String                       @id
  codigo                String?
  proveedorId           String?
  proyectoId            String?
  ordenCompraId         String?                      @unique(map: "GASTO_ordenCompraId_key")
  cajaId                String?
  tipo                  gasto_tipo                   @default(OPERATIVO)
  clasificacion         gasto_clasificacion          @default(VENTA_SERVICIO)
  categoriaDistribucion gasto_categoriaDistribucion?
  concepto              String                       @db.Text
  montoTotal            Decimal                      @db.Decimal(18, 2)
  saldoPendiente        Decimal                      @db.Decimal(18, 2)
  fechaEmision          DateTime                     @default(now())
  fechaVencimiento      DateTime?
  fechaPago             DateTime?
  estado                gasto_estado                 @default(PENDIENTE)
  comprobanteUrl        String?
  registradoPorId       String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime
  aprobadorFinanzasId   String?
  aprobadorGerenciaId   String?
  area                  gasto_area?
  estadoRendicion       gasto_estadoRendicion?       @default(PENDIENTE)
  justificacion         String?                      @db.Text
  montoRendido          Decimal?                     @default(0.00) @db.Decimal(18, 2)
  nivelAprobacion       gasto_nivelAprobacion?
  solicitanteId         String?
  fechaProgramadaPago   DateTime?
  nivelActual           Int                          @default(0)
  prioridad             gasto_prioridad              @default(MEDIA)
  aprobacion_gasto      aprobacion_gasto[]
  caja                  caja?                        @relation(fields: [cajaId], references: [id], map: "GASTO_cajaId_fkey")
  orden_compra          orden_compra?                @relation(fields: [ordenCompraId], references: [id], map: "GASTO_ordenCompraId_fkey")
  proveedor             proveedor?                   @relation(fields: [proveedorId], references: [id], map: "GASTO_proveedorId_fkey")
  proyecto              proyecto?                    @relation(fields: [proyectoId], references: [id], map: "GASTO_proyectoId_fkey")
  pago                  pago[]
  rendicion             rendicion[]

  @@index([cajaId], map: "GASTO_cajaId_fkey")
  @@index([fechaProgramadaPago], map: "GASTO_fechaProgramadaPago_idx")
  @@index([proveedorId], map: "GASTO_proveedorId_fkey")
  @@index([proyectoId], map: "GASTO_proyectoId_fkey")
}

model historialcambio {
  id            String               @id
  proyectoId    String?
  actividadId   String?
  campo         String
  valorAnterior String               @db.Text
  valorNuevo    String               @db.Text
  usuario       String
  area          historialcambio_area
  fecha         DateTime             @default(now())
  motivo        String?              @db.Text
  actividad     actividad?           @relation(fields: [actividadId], references: [id], onDelete: Cascade, map: "HistorialCambio_actividadId_fkey")
  proyecto      proyecto?            @relation(fields: [proyectoId], references: [id], onDelete: Cascade, map: "HistorialCambio_proyectoId_fkey")

  @@index([actividadId], map: "HistorialCambio_actividadId_fkey")
  @@index([proyectoId], map: "HistorialCambio_proyectoId_fkey")
}

model hito_pago {
  id            String           @id
  cotizacionId  String
  descripcion   String
  porcentaje    Decimal          @db.Decimal(5, 2)
  monto         Decimal          @db.Decimal(18, 2)
  fechaEstimada DateTime?
  estado        hito_pago_estado @default(PENDIENTE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime
  factura       factura[]
  cotizacion    cotizacion       @relation(fields: [cotizacionId], references: [id], onDelete: Cascade, map: "HITO_PAGO_cotizacionId_fkey")

  @@index([cotizacionId], map: "HITO_PAGO_cotizacionId_fkey")
}

model indicadoravance {
  id                     String               @id
  proyectoId             String
  area                   indicadoravance_area
  porcentaje             Float
  actividadesTotal       Int
  actividadesCompletadas Int
  ultimaActualizacion    DateTime
  proyecto               proyecto             @relation(fields: [proyectoId], references: [id], map: "IndicadorAvance_proyectoId_fkey")

  @@index([proyectoId], map: "IndicadorAvance_proyectoId_fkey")
}

model ingenieriadiseno {
  id                   String        @id
  proyectoId           String        @unique(map: "IngenieriaDiseno_proyectoId_key")
  fechaInicio          DateTime
  fechaFinEstimada     DateTime?
  ingenieroResponsable String
  especificaciones     String        @db.LongText
  estado               String
